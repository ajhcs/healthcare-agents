{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajhcs/healthcare-agents/review-protocols/contracts/strategic-review.v1.schema.json",
  "title": "USHSO Strategic Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "request_id", "review_tier", "protocol", "reviewer", "input_hashes", "frozen_inputs", "frozen_inputs_hash", "evidence_bundle_ref", "identity_binding_ref", "decision_scenario_ref", "first_assessment_hash", "exposure_status", "evidence_mutated", "posture_assessments", "claim_dispositions", "missing_evidence_requests", "method_challenges", "prohibited_claims", "preserved_reviewer_concerns", "overall_disposition", "professional_disposition_authority", "evaluation", "output_sha256"],
  "properties": {
    "schema_version": {"const": "ushso.strategic-review.v1"},
    "review_id": {"$ref": "review-request.v1.schema.json#/$defs/text"},
    "request_id": {"$ref": "review-request.v1.schema.json#/$defs/text"},
    "review_tier": {"$ref": "review-request.v1.schema.json#/$defs/reviewTier"},
    "protocol": {"$ref": "review-request.v1.schema.json#/$defs/resolvedProtocol"},
    "reviewer": {"$ref": "review-request.v1.schema.json#/$defs/reviewer"},
    "input_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "review-request.v1.schema.json#/$defs/hash"}},
    "frozen_inputs": {"$ref": "review-request.v1.schema.json#/$defs/frozenInputs"},
    "frozen_inputs_hash": {"$ref": "review-request.v1.schema.json#/$defs/hash"},
    "evidence_bundle_ref": {"$ref": "review-request.v1.schema.json#/$defs/text"},
    "identity_binding_ref": {"$ref": "review-request.v1.schema.json#/$defs/text"},
    "decision_scenario_ref": {"$ref": "review-request.v1.schema.json#/$defs/text"},
    "first_assessment_hash": {"$ref": "review-request.v1.schema.json#/$defs/hash"},
    "exposure_status": {"const": "independent_first"},
    "evidence_mutated": {"const": false},
    "posture_assessments": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "review-request.v1.schema.json#/$defs/postureAssessment"}},
    "claim_dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "review-request.v1.schema.json#/$defs/claimDisposition"}},
    "missing_evidence_requests": {"type": "array", "items": {"$ref": "review-request.v1.schema.json#/$defs/missingEvidenceRequest"}},
    "method_challenges": {"type": "array", "items": {"$ref": "review-request.v1.schema.json#/$defs/methodChallenge"}},
    "prohibited_claims": {"$ref": "review-request.v1.schema.json#/$defs/stringList"},
    "preserved_reviewer_concerns": {"$ref": "review-request.v1.schema.json#/$defs/stringList"},
    "overall_disposition": {"enum": ["pass", "pass_with_caveats", "block"]},
    "professional_disposition_authority": {"const": "human_required"},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["valid", "criteria_results", "advisory_only"], "properties": {"valid": {"const": true}, "criteria_results": {"type": "array", "minItems": 1, "items": {"$ref": "review-request.v1.schema.json#/$defs/criterionResult"}}, "advisory_only": {"const": true}}},
    "output_sha256": {"$ref": "review-request.v1.schema.json#/$defs/hash"}
  }
}
