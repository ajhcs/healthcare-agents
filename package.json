{
  "name": "healthcare-agents",
  "version": "1.4.0",
  "description": "Portable prompt and SKILL.md pack with 51 specialist AI agents for US healthcare administration workflows.",
  "keywords": [
    "healthcare",
    "healthcare-administration",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "cursor-rules",
    "copilot",
    "healthcare-ai",
    "medical-coding",
    "hipaa",
    "cms",
    "revenue-cycle"
  ],
  "bin": {
    "healthcare-agents": "bin/cli.js"
  },
  "scripts": {
    "scorecard": "node scripts/generate-scorecard.js",
    "validate:eval-coverage": "node scripts/validate-eval-coverage.js",
    "validate:scorecard": "node scripts/generate-scorecard.js && node scripts/validate-scorecard-claims.js",
    "validate:registry": "node scripts/validate-registry-consistency.js && node scripts/validate-source-freshness.js",
    "validate:workflows": "node scripts/validate-workflows.js && node scripts/validate-workup-canaries.js && node scripts/validate-platform-exports.js",
    "validate:evidence-packs": "node scripts/validate-evidence-packs.js",
    "validate:workflow-docs": "node scripts/validate-workflow-docs.js",
    "validate:npm-publish-workflow": "node scripts/validate-npm-publish-workflow.js",
    "validate:safety": "node scripts/validate-safety-boundaries.js",
    "validate:manifest": "node scripts/validate-release-manifest.js",
    "test:platform-snapshots": "node scripts/test-platform-render-snapshots.js",
    "test:cli": "node scripts/test-cli-regression.js",
    "test:evidence-packs": "node scripts/test-evidence-pack-regression.js",
    "test:case-data-provider": "node scripts/test-case-data-provider.js",
    "test:denial-spike-golden": "node scripts/test-denial-spike-golden-artifact.js",
    "test:installer": "bash scripts/test-installer-e2e.sh",
    "test:routing": "node scripts/run-routing-benchmark.js",
    "test:packlist": "node scripts/validate-packlist.js",
    "test:tarball": "node scripts/test-tarball-smoke.js",
    "security:static": "bash scripts/static-security-checks.sh",
    "verify:public-release": "node scripts/verify-public-release.js",
    "verify:public-release:network": "node scripts/verify-public-release.js --network",
    "validate:public-version-sync": "node scripts/validate-public-version-sync.js",
    "release:check": "bash scripts/release-readiness.sh",
    "test": "npm run release:check"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".claude/commands/eval.md",
    "AGENTS.md",
    "agents/",
