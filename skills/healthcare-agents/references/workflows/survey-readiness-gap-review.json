    "Tracer plan",
    "Policy evidence list",
    "Owner matrix",
    "Leadership briefing",
    "Readiness cadence"
  ],
  "safety_constraints": [
    "no_medical_advice",
    "no_phi_by_default",
    "local_policy_review",
