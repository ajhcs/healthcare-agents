{
  "id": "pharmacy-contract-scorecard",
  "name": "PBM or Pharmacy Contract Scorecard",
  "category": "Pharmacy",
  "summary": "Frame pharmacy spend, PBM terms, rebate questions, formulary performance, specialty spend, and negotiation evidence into a scorecard.",
  "primary_agent": "pharmacy-benefits-specialist",
  "handoff_agents": [
    "revenue-finance-manager",
    "revenue-contract-analyst",
    "healthit-clinical-data-analyst"
  ],
  "required_inputs": [
    "contract terms",
    "utilization",
    "rebate terms",
    "specialty spend",
    "claims sample"
  ],
  "optional_inputs": [
    "formulary tier data",
    "guarantees",
    "audit rights",
    "spread pricing terms"
  ],
  "red_flags": [
    "legal contract dispute",
    "clinical formulary governance needed",
    "large unvalidated savings claim",
    "PHI in claims sample"
  ],
  "output_artifact": "pharmacy contract scorecard",
  "artifact_sections": [
    "Scorecard structure",
    "Data request list",
    "Variance hypotheses",
    "Rebate and specialty spend review",
    "Negotiation points"
  ],
  "review_guidance": "Prepare a pharmacy contract scorecard tying utilization, rebates, specialty spend and net cost to effective plan terms and denominators. Flag exclusions and assumptions and name the pharmacy and contracting owners who can verify them.",
  "safety_constraints": [
    "no_medical_advice",
    "no_phi_by_default",
    "local_policy_review",
    "escalate_required"
  ]
}
