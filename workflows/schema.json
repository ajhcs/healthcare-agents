{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajhcs/healthcare-agents/workflows/schema.json",
  "title": "Healthcare Agents Workflow Registry",
  "type": "object",
  "required": ["schema_version", "workflows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "example": {
      "type": "object",
      "required": ["input", "expected_workflow"],
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "expected_workflow": { "type": "string", "minLength": 1 },
        "target": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "summary",
        "triggers",
        "anti_triggers",
        "primary_agent",
        "handoff_agents",
        "required_inputs",
        "optional_inputs",
        "red_flags",
        "output_artifact",
        "artifact_sections",
        "safety_constraints",
        "platform_prompt_templates",
        "examples",
        "canary_tests"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "triggers": { "$ref": "#/$defs/stringArray" },
        "anti_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "primary_agent": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "handoff_agents": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "required_inputs": { "$ref": "#/$defs/stringArray" },
        "optional_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "red_flags": { "$ref": "#/$defs/stringArray" },
        "output_artifact": { "type": "string", "minLength": 1 },
        "artifact_sections": { "$ref": "#/$defs/stringArray" },
        "safety_constraints": { "$ref": "#/$defs/stringArray" },
        "platform_prompt_templates": {
          "type": "object",
          "required": ["claude", "codex", "copilot", "m365_copilot"],
          "additionalProperties": false,
          "properties": {
            "claude": { "type": "string", "minLength": 1 },
            "codex": { "type": "string", "minLength": 1 },
            "copilot": { "type": "string", "minLength": 1 },
            "m365_copilot": { "type": "string", "minLength": 1 }
          }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/example" }
        },
        "canary_tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/example" }
        }
      }
    }
  }
}
